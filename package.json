{
  "name": "@local/dsh-mineru",
  "version": "0.3.0",
  "private": true,
  "description": "MinerU 文档解析：自动探测 Node 与 mineru-mcp，设置页只需填 API Key。",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "environment.js",
    "client.js",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "skill/SKILL.md"
  ],
  "dependencies": {
    "mineru-mcp": "^1.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
