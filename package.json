{
  "name": "@unison777/dsh-mineru",
  "version": "0.3.1",
  "description": "MinerU 文档解析：自动探测 Node 与 mineru-mcp，设置页只需填 API Key。",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "environment.js",
    "client.js",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "skill/SKILL.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "mineru",
    "pdf",
    "ocr",
    "markdown",
    "mcp"
  ],
  "license": "MIT",
  "author": {
    "name": "unison777"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unison777/dsh-mineru.git"
  },
  "homepage": "https://github.com/unison777/dsh-mineru#readme",
  "bugs": {
    "url": "https://github.com/unison777/dsh-mineru/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "mineru-mcp": "^1.2.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
